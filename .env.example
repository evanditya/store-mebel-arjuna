# ============================================
# DATABASE (Required)
# ============================================
# For Replit: Add PostgreSQL from Tools menu - DATABASE_URL is auto-set
# For local: Set your PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/store

# ============================================
# AUTHENTICATION (Auto-generated)
# ============================================
# JWT Secret - auto-generated on first run via start.sh
# Or generate manually: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# ============================================
# OTTOPAY PAYMENT GATEWAY (Required for payments)
# ============================================
# 1. Register at https://ottopay.id
# 2. Go to dashboard → API Keys
# 3. Copy Merchant ID and API Key
#
# For SANDBOX (testing):
#   Endpoint: https://gateway-sandbox.ottopay.id
#   Set OTTOPAY_IS_PRODUCTION=false (default)
#
# For PRODUCTION:
#   Endpoint: https://gateway.ottopay.id
#   Set OTTOPAY_IS_PRODUCTION=true
#
# Webhook URL to register in OttoPay dashboard:
#   https://<your-domain>/api/payment/notification
#
# On Replit: Add these as Secrets in the Secrets tab
OTTOPAY_MERCHANT_ID=
OTTOPAY_API_KEY=
OTTOPAY_IS_PRODUCTION=false

# ============================================
# FRONTEND URL (CORS + links)
# ============================================
# Local: http://localhost:5000
# Railway: https://<service>.up.railway.app
FRONTEND_URL=http://localhost:5000

# ============================================
# BITESHIP SHIPPING API (Optional)
# ============================================
# 1. Register at https://biteship.com
# 2. Go to Settings > API Keys
# 3. Copy your API key
BITESHIP_API_KEY=

# ============================================
# PERSISTENT STORAGE (Railway volume)
# ============================================
# Leave unset locally (defaults to backend/uploads and backend/seller_config.json)
# On Railway with volume mounted at /data:
# UPLOAD_DIR=/data/uploads
# SELLER_CONFIG_PATH=/data/seller_config.json
